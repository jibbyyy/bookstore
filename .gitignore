# =============================
# Unity Default .gitignore
# =============================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/
Recordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# [Aa]ssets/AssetStoreTools*

# JetBrains Rider
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Android builds
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Crashlytics
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# =============================
# ML-Agents & Python Specific
# =============================

# Python Virtual Environment
mlagents-env/
env/
venv/
ENV/
.Python

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class

# Training results & logs
results/
*.onnx
*.tfevents.*

# Jupyter
.ipynb_checkpoints/

# VSCode
.vscode/

# Mac System Files
.DS_Store
